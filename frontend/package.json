{
	"name": "insights-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"dev": "vite",
		"serve": "vite preview",
		"lint:e2e": "eslint e2e --ext .ts",
		"test": "vitest run",
		"build": "vite build -l warn --base=/assets/insights/frontend/ && yarn copy-html-entry",
		"copy-html-entry": "cp ../insights/public/frontend/index.html ../insights/www/_insights.html",
		"postinstall": "patch-package && patch-package --patch-dir node_modules/@framework/ui/patches"
	},
	"dependencies": {
		"@codemirror/lang-javascript": "^6.0.2",
		"@codemirror/lang-python": "^6.1.3",
		"@codemirror/lang-sql": "^6.4.0",
		"@formkit/auto-animate": "^0.8.1",
		"@tanstack/vue-table": "^8.10.7",
		"@types/vue-router": "^2.0.0",
		"@vue-flow/core": "^1.23.0",
		"@vueuse/core": "^10.7.2",
		"codemirror": "^6.0.1",
		"dayjs": "^1.11.6",
		"dompurify": "^3.4.0",
		"echarts": "^6.1.0",
		"es-toolkit": "^1.34.1",
		"feather-icons": "^4.28.0",
		"frappe-ui": "1.0.0-beta.62",
		"html-to-image": "^1.11.13",
		"lucide-vue-next": "^0.484.0",
		"pinia": "^2.0.30",
		"reka-ui": "^2.9.9",
		"socket.io-client": "^4.5.1",
		"thememirror": "^2.0.1",
		"vue": "^3.5.13",
		"vue-codemirror": "^6.0.1",
		"vue-router": "^4.2.2",
		"vuedraggable": "^4.1.0"
	},
	"devDependencies": {
		"@framework/ui": "link:../../frappe/ui",
		"@iconify/utils": "2.3.0",
		"@playwright/test": "^1.42.0",
		"@tailwindcss/container-queries": "^0.1.1",
		"@types/node": "^20.14.0",
		"@typescript-eslint/parser": "^8.66.0",
		"@vitejs/plugin-vue": "^4.2.3",
		"@vitejs/plugin-vue-jsx": "^3.0.1",
		"autoprefixer": "^10.4.7",
		"eslint": "^8.19.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-playwright": "^2.11.0",
		"eslint-plugin-prettier": "^5.1.3",
		"eslint-plugin-vue": "^9.1.1",
		"patch-package": "^8.0.1",
		"postcss": "^8.4.14",
		"prettier": "3.1.0",
		"tailwindcss": "3.4.17",
		"typescript": "^5.5.2",
		"vite": "^4.4.6",
		"vitest": "^0.34.6",
		"vue-tsc": "^2.0.21"
	},
	"resolutions": {
		"@iconify/utils": "^2.3.0"
	}
}
