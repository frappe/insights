{
 "is_builder_query": 1,
 "is_native_query": 0,
 "is_script_query": 0,
 "operations": [
  {
   "table": {
    "data_source": "Site DB",
    "table_name": "tabPayment Entry",
    "type": "table"
   },
   "type": "source"
  },
  {
   "filters": [
    {
     "column": {
      "column_name": "docstatus",
      "type": "column"
     },
     "operator": "=",
     "value": 1
    },
    {
     "column": {
      "column_name": "payment_type",
      "type": "column"
     },
     "operator": "in",
     "value": [
      "Receive",
      "Pay"
     ]
    }
   ],
   "logical_operator": "And",
   "type": "filter_group"
  },
  {
   "data_type": "String",
   "expression": {
    "expression": "if_else(payment_type == 'Receive', 'Cash In', 'Cash Out')",
    "type": "expression"
   },
   "new_name": "flow",
   "type": "mutate"
  },
  {
   "data_type": "Decimal",
   "expression": {
    "expression": "if_else(payment_type == 'Receive', base_received_amount, base_paid_amount)",
    "type": "expression"
   },
   "new_name": "amount",
   "type": "mutate"
  },
  {
   "data_type": "Decimal",
   "expression": {
    "expression": "if_else(payment_type == 'Receive', base_received_amount, - base_paid_amount)",
    "type": "expression"
   },
   "new_name": "net_amount",
   "type": "mutate"
  }
 ],
 "sort_order": 2,
 "title": "Payments Cash Flow",
 "use_live_connection": 1,
 "variables": []
